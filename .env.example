# Tally — overridable compose variables.
#
# You do not need this file to run the project. Every variable here is already
# defaulted inside docker-compose.yml, so `docker compose up --build` works on a
# bare clone. Copy it to `.env` only when you want to change one of them:
#
#   cp .env.example .env
#
# The defaults are local throwaway values. A real deployment injects these names
# from its own secret store and never ships a .env.

# --- Published host ports -----------------------------------------------------
# Change these if something on your machine already owns 3000 or 3001.
# GATEWAY_PORT also rebuilds into the web image: the browser's API URL is
# http://localhost:${GATEWAY_PORT}, baked at build time. Change it and rebuild:
#   docker compose up --build
WEB_PORT=3000
GATEWAY_PORT=3001

# Postgres is not published by the base compose file. This port applies only to
# the docker-compose.dev.yml override, which exposes the database to the host.
POSTGRES_PORT=5432

# --- Database -----------------------------------------------------------------
# Consumed by the postgres container and interpolated into each service's
# DATABASE_URL, so the two always agree. The password is URL-safe on purpose:
# characters like @ or / would need percent-encoding inside a connection string.
# auth_db and tasks_db are created by docker/init-db.sql on first boot; they are
# not configurable here.
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally_dev_only_not_a_secret
POSTGRES_DB=tally
