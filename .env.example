# Tally — overridable compose variables.
#
# You do not need this file to run the project. Every variable here is already
# defaulted inside docker-compose.yml, so `docker compose up --build` works on a
# bare clone. Copy it to `.env` only when you want to change one of them:
#
#   cp .env.example .env
#
# The defaults are local throwaway values. A real deployment injects these names
# from its own secret store and never ships a .env.

# --- Published host ports -----------------------------------------------------
# Change these if something on your machine already owns 3000 or 3001.
# GATEWAY_PORT also rebuilds into the web image: the browser's API URL is
# http://localhost:${GATEWAY_PORT}, baked at build time. Change it and rebuild:
#   docker compose up --build
WEB_PORT=3000
GATEWAY_PORT=3001

# Postgres is not published by the base compose file. This port applies only to
# the docker-compose.dev.yml override, which exposes the database to the host.
POSTGRES_PORT=5432

# --- Database -----------------------------------------------------------------
# Consumed by the postgres container and interpolated into each service's
# DATABASE_URL. The password is URL-safe on purpose: characters like @ or /
# would need percent-encoding inside a connection string. auth_db and tasks_db
# are created by docker/init-db.sql on first boot and are not configurable here.
#
# ⚠ These apply only while the data volume is empty. Postgres reads them once,
# at initdb; on any later boot it keeps the credentials it was created with.
# So changing them after a first run desynchronises the two sides, and the
# symptom is misleading: postgres reports healthy (pg_isready does not
# authenticate) while both services crash-loop on P1000 authentication failed.
# Change them together with a reset:
#
#   docker compose down -v && docker compose up --build
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally_dev_only_not_a_secret
POSTGRES_DB=tally

# --- Auth ---------------------------------------------------------------------
# HS256 signing key for access tokens. The auth service signs with it and the
# gateway verifies with it — one value, two containers, and a mismatch turns
# every protected request into a 401.
#
# ⚠ The value below is the development placeholder docker-compose.yml falls
# back to, and it is published in this repository. While it is in use, anyone
# holding a copy of the repo can forge an access token for any user id. It buys
# a zero-step `docker compose up` and is fit for nothing else. Both apps log a
# warning at boot when they are started with it, because the variable is always
# set on the documented run path — so no amount of `getOrThrow` would notice.
# Replace it for any deployment. Rotating it invalidates every access token in
# flight; refresh cookies survive, since they are opaque and not signed.
#
#   openssl rand -base64 32
JWT_SECRET=dev-only-not-a-secret-change-me

# `Secure` on the refresh cookie: "true" or "false", and nothing else — the
# gateway refuses to start on any other value rather than guessing. Must be
# false for the compose stack, which serves plain http on localhost (a browser
# discards a Secure cookie over http and the user is silently logged out on
# reload), and true anywhere served over https.
COOKIE_SECURE=false
