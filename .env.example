# Overridable compose variables. You do not need this file — docker-compose.yml
# already defaults every name below to the same value. Copy it to `.env` to
# change one. GATEWAY_PORT is baked into the web bundle, so it needs `--build`.
WEB_PORT=3000
GATEWAY_PORT=3001

# Only docker-compose.dev.yml publishes the database; the base file does not.
POSTGRES_PORT=5432

# ⚠ Read once, at initdb on an empty volume, and kept afterwards. Changing them
# on a later boot desynchronises the two sides and the symptom misleads:
# postgres reports healthy (pg_isready does not authenticate) while both
# services crash-loop on P1000. Change them together with a reset:
# `docker compose down -v && docker compose up --build`.
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally_dev_only_not_a_secret
POSTGRES_DB=tally

# ⚠ HS256 key: the auth service signs with it, the gateway verifies with it, and
# a mismatch makes every protected request a 401. This value is published in
# this repo, so anyone holding a copy can forge a token for any user id — both
# apps warn at boot while it is in use. Replace it (`openssl rand -base64 32`)
# anywhere that is not a local demo. See the README's limitations.
JWT_SECRET=dev-only-not-a-secret-change-me

# "true" or "false" and nothing else — the gateway throws at startup on any
# other value. False for this stack (plain http on localhost); true over https.
COOKIE_SECURE=false
