# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma clients, regenerated from prisma/schema.prisma by `pnpm build`,
# `typecheck` and `test`, and again inside each image's runtime stage.
apps/*/generated/

# test + coverage output
coverage/

# env — compose carries dev fallbacks; real values are never committed
.env
.env.*
!.env.example

# `design/` is deliberately NOT ignored. It was excluded at first, on the
# reasoning that shipping working material makes the deliverable look larger
# than the thing being reviewed — but it is the source the UI was built from,
# and a reviewer seeing the tokens and mockups can tell a considered interface
# from an accidental one. Committed on the repo owner's call; the README says
# what it is and how it was produced.

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
