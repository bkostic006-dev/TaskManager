# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma clients, regenerated from prisma/schema.prisma by `pnpm build`,
# `typecheck` and `test`, and again inside each image's runtime stage.
apps/*/generated/

# test + coverage output
coverage/

# env — compose carries dev fallbacks; real values are never committed
.env
.env.*
!.env.example

# Design working material, not product: 4,329 lines of tokens, mockups and
# exported prototype artifacts that the app never imports. Kept on disk because
# CLAUDE.md's Design section builds UI from it; out of the repo because shipping
# it makes the deliverable look larger than the thing being reviewed.
design/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
